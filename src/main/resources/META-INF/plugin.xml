<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.sofiafo.codeexplorer</id>
    <name>Code Explorer</name>
    <vendor>sofiafo</vendor>
    <description><![CDATA[
        <p><b>Code Explorer</b> analisa as relações entre classes do projeto e exibe métricas de fan-in e fan-out.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="CodeExplorer"
                secondary="false"
                anchor="right"
                factoryClass="com.sofia.codeexplorer.ui.CodeExplorerToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="com.sofia.codeexplorer.actions.AnalyzeProjectAction"
                class="com.sofia.codeexplorer.actions.AnalyzeProjectAction"
                text="Analisar Projeto (Code Explorer)"
                description="Analisa dependências entre classes do projeto">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
